{{define "content"}}
{{$c := .Content}}
<div class="pagehead">
  <div>
    {{if $c.BackURL}}<a class="back" href="{{$c.BackURL}}">{{template "icon" "arrow-left"}} All groups</a>{{end}}
    <h1>{{if $c.Group}}{{$c.Group}}{{else if $c.Mine}}Your projects{{else}}Browse groups &amp; projects{{end}}</h1>
    <p class="sub">{{if or $c.Group $c.Mine}}Pick a project to list its merge requests.{{else}}Pick a group or project to list its merge requests.{{end}}</p>
  </div>
  <span class="spacer"></span>
  {{if $c.GroupMRsURL}}<a class="btn btn-primary" href="{{$c.GroupMRsURL}}">{{template "icon" "mr"}} Browse whole group</a>{{end}}
</div>

{{if and $c.NeedsScope (not (or $c.Group $c.Mine))}}
<div class="notice">{{template "icon" "info"}}<div>No projects or groups are configured for this instance, so pick what to browse. Set <code>gitlab.projects</code> or <code>gitlab.groups</code> in <a href="/settings">Settings</a> to skip this step.</div></div>
{{end}}

<form method="get" class="listbar">
  {{if $c.Group}}<input type="hidden" name="group" value="{{$c.Group}}">{{end}}
  {{if $c.Mine}}<input type="hidden" name="mine" value="1">{{end}}
  <label class="field grow">{{template "icon" "search"}}<input type="search" name="search" placeholder="Search" value="{{$c.Search}}" aria-label="search"></label>
  <button type="submit" class="btn">Search</button>
</form>

{{if $c.Err}}<div class="notice error">{{template "icon" "warn"}}<div>{{$c.Err}}</div></div>{{end}}

{{if $c.Rows}}
<div class="table-wrap">
<table class="table">
  <tbody>
    {{range $c.Rows}}
    <tr>
      <td><a class="strong" href="{{if .OpenURL}}{{.OpenURL}}{{else}}{{.MRsURL}}{{end}}">{{if .OpenURL}}{{template "icon" "organization"}}{{else}}{{template "icon" "repo"}}{{end}} {{.Label}}</a></td>
      <td class="muted">{{.Desc}}</td>
      <td class="actions-cell">{{if and .OpenURL .MRsURL}}<a class="btn btn-sm" href="{{.MRsURL}}">{{template "icon" "mr"}} Merge requests</a>{{end}}</td>
    </tr>
    {{end}}
  </tbody>
</table>
</div>
{{else if not $c.Err}}
<div class="empty compact">{{template "icon" "search"}}<h2>Nothing found</h2><p>Try a different search.</p></div>
{{end}}

{{template "pager" (pager $c.PrevURL $c.NextURL "Previous" "More")}}
{{end}}
