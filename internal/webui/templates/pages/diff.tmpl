{{define "content"}}
{{$c := .Content}}
<div class="diff-layout{{if $c.Split}} split-mode{{end}}" data-viewed-key="viewed:{{$c.Nav.Project}}!{{$c.Nav.IID}}@{{$c.Detail.HeadSHA}}" data-ctx-url="{{$c.ContextURL}}" data-ctx-ref="{{$c.HeadSHA}}">
  <aside class="filetree">
    <div class="filetree-head">
      <button type="button" class="filetree-toggle" aria-expanded="false" title="show or hide the file list">{{template "icon" "chevron-right"}}<span class="title">Files</span><span class="count">{{len $c.Files}}</span></button>
      <span class="spacer"></span>
      <span class="seg" role="group" aria-label="diff layout">
        <a href="{{$c.UnifiedURL}}"{{if not $c.Split}} class="on" aria-current="true"{{end}} title="unified layout">{{template "icon" "rows"}}<span class="label">Unified</span></a>
        <a href="{{$c.SplitURL}}"{{if $c.Split}} class="on" aria-current="true"{{end}} title="split layout">{{template "icon" "columns"}}<span class="label">Split</span></a>
      </span>
    </div>
    <div class="filetree-filter" hidden><label class="field">{{template "icon" "filter"}}<input type="search" id="file-filter" placeholder="Filter files" aria-label="filter files"></label></div>
    <ul class="tree">
      {{range $c.Explorer}}{{template "explorernode" .}}{{end}}
    </ul>
    <div class="filetree-foot"><span id="viewed-progress">0 of {{len $c.Files}} viewed</span><span class="progress" aria-hidden="true"><span id="viewed-bar"></span></span></div>
  </aside>

  <section class="diff-files">
    {{if $c.Detail.Description}}
    <details class="card mr-description">
      <summary class="card-head">{{template "icon" "chevron-right"}}<h2>Description</h2><span class="muted">{{$c.Detail.Title}}</span></summary>
      <div class="card-body md">{{markdown $c.Detail.Description}}</div>
    </details>
    {{end}}

    {{if $c.RecordName}}
    <p class="findings-banner">{{template "icon" "sparkle"}} Findings from the AI review run {{reltime $c.RecordTime}} are shown inline; <a href="{{$c.FindingsURL}}">open the findings page</a> to edit or publish them.</p>
    {{end}}

    {{if $c.GeneralFindings}}
    <details class="card general" open>
      <summary class="card-head">{{template "icon" "chevron-right"}}<h2>MR-level findings</h2><span class="count">{{len $c.GeneralFindings}}</span></summary>
      {{range $c.GeneralFindings}}{{template "difffinding" (findingrow . $c)}}{{end}}
    </details>
    {{end}}

    {{if $c.General}}
    <section class="card general">
      <header class="card-head"><h2>Pending MR-level comments</h2><span class="count">{{len $c.General}}</span></header>
      <ul class="pending-comments">
        {{range $c.General}}
        <li><span class="pill manual">{{fstate .State}}</span> <span class="body">{{ftitle .}}</span></li>
        {{end}}
      </ul>
    </section>
    {{end}}

    {{range $c.Files}}
    <article class="diff-file" id="file-{{.Index}}" data-path="{{.NewPath}}">
      <header class="file-header">
        <button type="button" class="file-fold" title="collapse / expand this file" aria-label="collapse or expand">{{template "icon" "chevron-down"}}</button>
        <span class="fstatus fstatus-{{.Status}}" title="{{.Status}}">{{.Letter}}</span>
        <span class="fpath">{{.Path}}</span>
        <span class="addel"><span class="a">+{{.Adds}}</span> <span class="d">−{{.Dels}}</span></span>
        {{if .Comments}}<span class="pill comments" title="discussion comments">{{template "icon" "chat"}} {{.Comments}}</span>{{end}}
        {{if .Findings}}<span class="pill findingcount" title="review findings">{{template "icon" "warn"}} {{.Findings}}</span>{{end}}
        <span class="spacer"></span>
        <label class="viewed-label"><input type="checkbox" class="viewed-box"> Viewed</label>
      </header>
      <div class="file-body">
      {{if .TooLarge}}<p class="note">This file's diff is too large to display.</p>{{end}}
      {{$file := .}}
      {{if $c.Split}}
      <table class="diff split">
        {{/* fixed layout sizes columns from the first row, which is usually a
             colspan'd hunk header, so pin the widths with cols instead */}}
        <colgroup>
          <col class="c-ln"><col class="c-gutter"><col class="c-code">
          <col class="c-ln"><col class="c-gutter"><col class="c-code">
        </colgroup>
        {{range .Rows}}
        {{if .Hunk}}
        <tr class="hunk"{{with .Expand}} data-ctx-new="{{.New}}" data-ctx-offset="{{.Offset}}" data-ctx-min="{{.Min}}"{{end}}><td class="ln" colspan="2">{{if .Expand}}<button type="button" class="expand-ctx" title="show more lines above" aria-label="show more lines above">{{template "icon" "unfold"}}</button>{{end}}</td><td class="code" colspan="4">{{.Hunk}}</td></tr>
        {{else}}
        <tr class="line">
          <td class="ln {{.Left.Kind}}">{{if .Left.Num}}{{.Left.Num}}{{end}}</td>
          <td class="gutter {{.Left.Kind}}">{{if eq .Left.Kind "del"}}<button type="button" class="add-comment" title="add a comment on this line" aria-label="add a comment on this line" data-file="{{$file.NewPath}}" data-old="{{.Left.Num}}" data-new="">{{template "icon" "plus"}}</button>{{end}}</td>
          <td class="code {{.Left.Kind}}">{{.Left.HTML}}</td>
          <td class="ln {{.Right.Kind}}">{{if .Right.Num}}{{.Right.Num}}{{end}}</td>
          <td class="gutter {{.Right.Kind}}">{{if eq .Right.Kind "add"}}<button type="button" class="add-comment" title="add a comment on this line" aria-label="add a comment on this line" data-file="{{$file.NewPath}}" data-old="" data-new="{{.Right.Num}}">{{template "icon" "plus"}}</button>{{else if eq .Right.Kind "ctx"}}<button type="button" class="add-comment" title="add a comment on this line" aria-label="add a comment on this line" data-file="{{$file.NewPath}}" data-old="{{.Left.Num}}" data-new="{{.Right.Num}}">{{template "icon" "plus"}}</button>{{end}}</td>
          <td class="code {{.Right.Kind}}">{{.Right.HTML}}</td>
        </tr>
        {{range .Findings}}
        <tr class="inline-comment"><td colspan="2" class="ln"></td><td colspan="4">{{template "difffinding" (findingrow . $c)}}</td></tr>
        {{end}}
        {{range .Threads}}
        <tr class="inline-comment"><td colspan="2" class="ln"></td><td colspan="4">{{template "diffthread" (threadrow . $c)}}</td></tr>
        {{end}}
        {{end}}
        {{end}}
        {{with $file.Tail}}
        <tr class="hunk expander-tail" data-ctx-new="{{.New}}" data-ctx-offset="{{.Offset}}" data-ctx-down="1"><td class="ln" colspan="2"><button type="button" class="expand-ctx" title="show more lines below" aria-label="show more lines below">{{template "icon" "fold-down"}}</button></td><td class="code" colspan="4"></td></tr>
        {{end}}
      </table>
      {{else}}
      <table class="diff">
        {{range .Lines}}
        {{if eq .Kind "hunk"}}
        <tr class="hunk"{{with .Expand}} data-ctx-new="{{.New}}" data-ctx-offset="{{.Offset}}" data-ctx-min="{{.Min}}"{{end}}><td class="ln" colspan="3">{{if .Expand}}<button type="button" class="expand-ctx" title="show more lines above" aria-label="show more lines above">{{template "icon" "unfold"}}</button>{{end}}</td><td class="code">{{.HTML}}</td></tr>
        {{else}}
        <tr class="line {{.Kind}}" data-file="{{$file.NewPath}}" data-old="{{.Old}}" data-new="{{.New}}">
          <td class="ln">{{if .Old}}{{.Old}}{{end}}</td>
          <td class="ln">{{if .New}}{{.New}}{{end}}</td>
          <td class="gutter">{{if .CanComment}}<button type="button" class="add-comment" title="add a comment on this line" aria-label="add a comment on this line">{{template "icon" "plus"}}</button>{{end}}</td>
          <td class="code">{{.HTML}}</td>
        </tr>
        {{range .Findings}}
        <tr class="inline-comment"><td colspan="3" class="ln"></td><td>{{template "difffinding" (findingrow . $c)}}</td></tr>
        {{end}}
        {{range .Threads}}
        <tr class="inline-comment"><td colspan="3" class="ln"></td><td>{{template "diffthread" (threadrow . $c)}}</td></tr>
        {{end}}
        {{end}}
        {{end}}
        {{with $file.Tail}}
        <tr class="hunk expander-tail" data-ctx-new="{{.New}}" data-ctx-offset="{{.Offset}}" data-ctx-down="1"><td class="ln" colspan="3"><button type="button" class="expand-ctx" title="show more lines below" aria-label="show more lines below">{{template "icon" "fold-down"}}</button></td><td class="code"></td></tr>
        {{end}}
      </table>
      {{end}}
      </div>
    </article>
    {{end}}
  </section>
</div>

<template id="comment-form-template">
  <tr class="inline-comment new"><td class="ln"></td><td>
    <form method="post" action="{{$c.Nav.CommentURL}}" class="comment-form">
      <input type="hidden" name="project" value="{{$c.Nav.Project}}">
      <input type="hidden" name="iid" value="{{$c.Nav.IID}}">
      <input type="hidden" name="back" value="{{$c.BackURL}}">
      <input type="hidden" name="file" value="">
      <input type="hidden" name="old" value="">
      <input type="hidden" name="new" value="">
      <textarea name="body" rows="3" placeholder="Posted verbatim as your own comment. Markdown supported." aria-label="comment"></textarea>
      <div class="row">
        <button type="submit" class="btn btn-primary btn-sm">Add comment</button>
        <button type="submit" class="btn btn-sm" formaction="{{$c.Nav.ChatURL}}" title="open a chat with Claude about this line; your text becomes the first message">{{template "icon" "discussion"}} Ask Claude</button>
        <button type="button" class="btn btn-ghost btn-sm cancel-comment">Cancel</button>
        <span class="spacer"></span>
        <span class="hint"><kbd>⌘</kbd><kbd>↵</kbd> submit · <kbd>esc</kbd> close</span>
      </div>
    </form>
  </td></tr>
</template>
{{end}}

{{define "explorernode"}}
{{if .File}}
<li class="file-entry" data-path="{{.File.NewPath}}"><a href="#file-{{.File.Index}}" title="{{.File.Path}}"><span class="fstatus fstatus-{{.File.Status}}">{{.File.Letter}}</span><span class="fname">{{.Name}}</span>{{if .File.Comments}}<span class="tcount" title="discussion comments">{{template "icon" "chat"}}{{.File.Comments}}</span>{{end}}{{range .File.Sevs}}<span class="sevdot {{.}}" title="{{.}} finding"></span>{{end}}<span class="viewed-tick" title="viewed">{{template "icon" "check"}}</span></a></li>
{{else}}
<li>
  <details open>
    <summary title="fold/unfold">{{template "icon" "chevron-down"}}{{template "icon" "folder"}}<span class="fname">{{.Name}}</span></summary>
    <ul>
      {{range .Children}}{{template "explorernode" .}}{{end}}
    </ul>
  </details>
</li>
{{end}}
{{end}}

{{define "difffinding"}}
<div class="finding f-inline state-{{fstate .F.State}}" id="df-{{.F.ID}}" data-finding="{{.F.ID}}">
  <header>
    {{template "sevbadge" .F}}
    <strong class="ftitle">{{ftitle .F}}</strong>
    <span class="spacer"></span>
    {{template "statebadge" .F.State}}
  </header>
  <pre class="prose">{{.F.Body}}</pre>
  {{if .F.Suggestion}}
  <div class="suggestion">
    <div class="suggestion-head">{{template "icon" "bulb"}} Suggested change</div>
    <pre class="prose add">{{.F.Suggestion}}</pre>
  </div>
  {{end}}
  <footer class="actions">
    {{template "findingactions" .}}
    <span class="spacer"></span>
    {{if .FindingsURL}}<a class="hint" href="{{.FindingsURL}}#f-{{.F.ID}}">Open in findings {{template "icon" "arrow-right"}}</a>{{end}}
  </footer>
</div>
{{end}}

{{define "diffthread"}}
{{$content := .Content}}
<details class="thread{{if .T.Resolved}} resolved{{end}}"{{if not .T.Resolved}} open{{end}}>
  <summary>
    {{with .T.First}}{{if .Pending}}<span class="avatar mine" aria-hidden="true">{{template "icon" "pencil"}}</span><span class="who">You</span>{{else}}<span class="avatar {{hue .Author}}" aria-hidden="true">{{initials .Author ""}}</span><span class="who">{{.Author}}</span>{{end}}{{end}}
    {{if gt (len .T.Comments) 1}}<span class="muted">· {{len .T.Comments}} comments</span>{{end}}
    {{with .T.First}}{{if not .When.IsZero}}<span class="muted">· {{reltime .When}}</span>{{end}}{{end}}
    <span class="spacer"></span>
    {{if .T.Resolved}}<span class="pill resolved">{{template "icon" "check"}} resolved</span>{{end}}
    <span class="chev">{{template "icon" "chevron-down"}}</span>
  </summary>
  {{range .T.Comments}}{{template "diffcomment" (commentrow . $content)}}{{end}}
</details>
{{end}}

{{define "diffcomment"}}
<div class="comment{{if .C.Pending}} pending{{end}}">
  <div class="meta">
    {{if .C.Pending}}<span class="pill manual">yours · {{.C.State}}</span>{{else}}<strong>{{.C.Author}}</strong> <span class="muted">{{reltime .C.When}}</span>{{end}}
  </div>
  <pre class="prose">{{.C.Body}}</pre>
  {{if and .C.Pending .C.ID}}
  <form method="post" action="{{.Nav.DeleteURL}}" class="inline-form">
    <input type="hidden" name="project" value="{{.Nav.Project}}">
    <input type="hidden" name="iid" value="{{.Nav.IID}}">
    <input type="hidden" name="id" value="{{.C.ID}}">
    <input type="hidden" name="back" value="{{.BackURL}}">
    <button type="submit" class="btn btn-ghost btn-xs btn-reject">{{template "icon" "trash"}} Delete</button>
  </form>
  {{end}}
</div>
{{end}}
