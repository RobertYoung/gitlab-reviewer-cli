{{define "content"}}
{{$c := .Content}}
<div class="pagehead">
  <div>
    <h1>Merge requests</h1>
    {{if $c.Scope}}<p class="sub">{{$c.Scope}}</p>{{end}}
  </div>
  <span class="spacer"></span>
  <a class="btn" href="{{$c.BrowseURL}}">{{template "icon" "repo"}} Browse groups &amp; projects</a>
</div>

<form method="get" class="listbar">
  <nav class="tabs statetabs" aria-label="state">
    {{range $c.StateTabs}}<a class="tab{{if .Current}} current{{end}}" href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}
  </nav>
  <span class="spacer"></span>
  {{if $c.State}}<input type="hidden" name="state" value="{{$c.State}}">{{end}}
  <label class="field grow">{{template "icon" "search"}}<input type="search" name="search" placeholder="Search title or description" value="{{$c.Search}}" aria-label="search title or description"></label>
  <label class="field">{{template "icon" "person"}}<input type="text" name="author" placeholder="Author username" value="{{$c.Author}}" aria-label="author username"></label>
  <label class="field">{{template "icon" "branch"}}<input type="text" name="target" placeholder="Target branch" value="{{$c.Target}}" aria-label="target branch"></label>
  {{if $c.NeedsScope}}
  <label class="field">{{template "icon" "repo"}}<input type="text" name="projects" placeholder="Projects (group/app, …)" value="{{$c.Projects}}" aria-label="projects, comma-separated"></label>
  <label class="field">{{template "icon" "organization"}}<input type="text" name="groups" placeholder="Groups (comma-separated)" value="{{$c.Groups}}" aria-label="groups, comma-separated"></label>
  {{else}}
  <input type="hidden" name="projects" value="{{$c.Projects}}">
  <input type="hidden" name="groups" value="{{$c.Groups}}">
  {{end}}
  <button type="submit" class="btn">Apply</button>
</form>

{{if $c.Err}}<div class="notice error">{{template "icon" "warn"}}<div>{{$c.Err}}</div></div>{{end}}

{{if $c.MRs}}
<div class="table-wrap">
<table class="table mr-table">
  <thead><tr><th>Merge request</th><th>Author</th><th>Pipeline</th><th>Threads</th><th>AI review</th><th>Updated</th></tr></thead>
  <tbody>
    {{range $i, $m := $c.MRs}}
    <tr>
      <td class="mr-title">
        <div class="mr-cell">
          {{if $m.Draft}}<span class="mr-icon draft" title="draft">{{template "icon" "mr-draft"}}</span>{{else}}<span class="mr-icon" title="{{$m.State}}">{{template "icon" "mr"}}</span>{{end}}
          <div>
            <a class="t" href="{{call $c.MRURL $m}}">{{if $m.Draft}}<span class="pill draft">Draft</span> {{end}}{{$m.Title}}</a>
            <div class="sub">{{$m.ProjectPath}} <span class="mono">!{{$m.IID}}</span> <span class="sep" aria-hidden="true">·</span> <span class="branch">{{$m.SourceBranch}}</span>{{template "icon" "arrow-right"}}<span class="branch">{{$m.TargetBranch}}</span></div>
          </div>
        </div>
      </td>
      <td class="mr-author"><span class="who" title="@{{$m.Author}}"><span class="avatar {{hue $m.Author}}" aria-hidden="true">{{initials $m.AuthorName $m.Author}}</span>{{if $m.AuthorName}}{{$m.AuthorName}}{{else}}@{{$m.Author}}{{end}}</span></td>
      <td class="mr-status" data-status-url="{{call $c.StatusURL $m}}"><span class="placeholder" aria-hidden="true"></span></td>
      <td class="mr-threads"></td>
      <td class="mr-review">
        {{- with index $c.Reviewed $i}}
        <a class="stage {{.Stage}}" href="{{.URL}}" title="last reviewed {{reltime .When}}: {{plural .Findings "finding"}}, {{.Accepted}} accepted">
          {{- if eq .Stage "clean"}}{{template "icon" "check"}} No findings
          {{- else if eq .Stage "triage"}}Triage · {{.Pending}} pending
          {{- else if eq .Stage "publish"}}Ready to publish · {{.Accepted}}
          {{- else if eq .Stage "published"}}{{template "icon" "send"}} Published · {{.Published}}
          {{- else}}{{template "icon" "check"}} Triaged{{end}}</a>
        <span class="when">{{reltime .When}}</span>
        {{- else}}
        <span class="stage none">Not reviewed</span>
        {{- end}}
      </td>
      <td class="mr-updated">{{reltime $m.UpdatedAt}}</td>
    </tr>
    {{end}}
  </tbody>
</table>
</div>
{{else if not $c.NeedsScope}}
<div class="empty">
  {{template "icon" "inbox"}}
  <h2>No merge requests match</h2>
  <p>Try another state, clear the search, or widen the projects and groups you browse.</p>
</div>
{{end}}

{{template "pager" (pager $c.PrevURL $c.NextURL "Newer" "Older")}}
{{end}}
