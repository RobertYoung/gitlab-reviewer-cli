{{define "content"}}
{{$c := .Content}}
{{$b := .Band}}
<div class="overview">
  <div class="stack">
    {{if $c.RebaseWarning}}<div class="notice warn">{{template "icon" "warn"}}<div>{{$c.RebaseWarning}}</div></div>{{end}}
    {{with $b.Gate}}{{if .Blocking}}<div class="notice warn">{{template "icon" "warn"}}<div>{{.Blocking}} finding(s) at or above {{.Severity}} in the last review{{if .Blocked}}; approval is blocked until they are resolved or rejected{{end}}</div></div>{{end}}{{end}}

    <section class="card">
      <header class="card-head"><h2>Description</h2></header>
      <div class="card-body md">
        {{if $c.Detail.Description}}{{markdown $c.Detail.Description}}{{else}}<p class="muted">No description provided.</p>{{end}}
      </div>
    </section>

    {{if $c.Commits}}
    <section class="card">
      <header class="card-head"><h2>Commits</h2><span class="count">{{len $c.Commits}}</span></header>
      <ul class="commits">
        {{range $c.Commits}}
        <li>{{template "icon" "commit"}}<span class="ctitle">{{.Title}}</span><code class="sha">{{.ShortID}}</code></li>
        {{end}}
      </ul>
    </section>
    {{end}}

    <section class="card" id="comments">
      <header class="card-head">
        <h2>Your pending comments</h2>
        {{if $c.Pending}}<span class="count">{{len $c.Pending}}</span>{{end}}
        <span class="spacer"></span>
        {{if $c.HasAccepted}}<a class="btn btn-sm" href="{{$c.Nav.PublishURL}}">{{template "icon" "send"}} Publish comments</a>{{end}}
      </header>
      {{if $c.Pending}}
      <ul class="pending-comments">
        {{range $c.Pending}}
        <li id="c-{{.ID}}">
          <span class="pill manual">{{fstate .State}}</span>
          <span class="loc">{{floc .}}</span>
          <span class="body">{{ftitle .}}</span>
          {{if eq (fstate .State) "accepted"}}
          <form method="post" action="{{$c.Nav.DeleteURL}}" class="inline-form">
            <input type="hidden" name="project" value="{{$c.Nav.Project}}">
            <input type="hidden" name="iid" value="{{$c.Nav.IID}}">
            <input type="hidden" name="id" value="{{.ID}}">
            <input type="hidden" name="back" value="{{$c.Nav.DetailURL}}">
            <button type="submit" class="btn btn-ghost btn-xs btn-reject" title="delete this comment">{{template "icon" "trash"}} Delete</button>
          </form>
          {{end}}
        </li>
        {{end}}
      </ul>
      {{else}}
      <p class="card-body muted">None yet. Add one below or from the diff with the <b>+</b> beside any line; they publish together with accepted review findings, or on their own.</p>
      {{end}}
      <details class="new-comment">
        <summary class="btn btn-sm">{{template "icon" "plus"}} Add an MR-level comment</summary>
        <form method="post" action="{{$c.Nav.CommentURL}}" class="stack-form">
          <input type="hidden" name="project" value="{{$c.Nav.Project}}">
          <input type="hidden" name="iid" value="{{$c.Nav.IID}}">
          <input type="hidden" name="back" value="{{$c.Nav.DetailURL}}">
          <textarea name="body" rows="4" placeholder="Posted verbatim as your own comment. Markdown supported." aria-label="comment"></textarea>
          <div class="row"><button type="submit" class="btn btn-primary">Add comment</button></div>
        </form>
      </details>
    </section>
  </div>

  <aside class="stack">
    <section class="card" id="approval">
      <header class="card-head"><h2>Approval</h2></header>
      <div class="card-body">
        {{with $b.Approvals}}
          {{if .ApprovedBy}}<p class="ok">{{template "icon" "check"}} Approved by {{join .ApprovedBy ", "}}</p>
          {{else if .ApprovalsRequired}}<p class="muted">{{.ApprovalsLeft}} of {{.ApprovalsRequired}} required approval(s) outstanding</p>
          {{else}}<p class="muted">No approvals yet.</p>{{end}}
          {{if .UserCanApprove}}
          <form method="post" action="{{$c.Nav.ApproveURL}}" class="approve-form">
            <input type="hidden" name="project" value="{{$c.Nav.Project}}">
            <input type="hidden" name="iid" value="{{$c.Nav.IID}}">
            <input type="hidden" name="back" value="{{$c.Nav.DetailURL}}">
            {{if .UserHasApproved}}
            <input type="hidden" name="action" value="unapprove">
            <button type="submit" class="btn">Unapprove</button>
            {{else if $b.Gate.Blocked}}
            <button type="button" class="btn" disabled title="blocked by gate.min_severity ({{$b.Gate.Severity}})">{{template "icon" "check"}} Approve</button>
            {{else}}
            <input type="hidden" name="sha" value="{{$c.Detail.HeadSHA}}">
            <button type="submit" class="btn btn-accept">{{template "icon" "check"}} {{if $b.Gate.Blocking}}Approve anyway{{else}}Approve{{end}}</button>
            {{end}}
          </form>
          {{end}}
        {{else}}
          <p class="muted">This instance reports no approval data for the MR.</p>
        {{end}}
      </div>
    </section>

    <section class="card">
      <header class="card-head"><h2>Details</h2></header>
      <dl class="facts">
        <dt>Pipeline</dt>
        <dd>{{with $c.Detail.Pipeline}}{{if .WebURL}}<a class="ci ci-{{.Status}}" href="{{.WebURL}}" target="_blank" rel="noopener">{{template "icon" (ciicon .Status)}} {{cilabel .Status}}</a>{{else}}<span class="ci ci-{{.Status}}">{{template "icon" (ciicon .Status)}} {{cilabel .Status}}</span>{{end}}{{else}}<span class="muted">none</span>{{end}}</dd>
        <dt>Source</dt><dd><span class="branch">{{$c.Detail.SourceBranch}}</span></dd>
        <dt>Target</dt><dd><span class="branch">{{$c.Detail.TargetBranch}}</span></dd>
        <dt>Author</dt><dd>{{$c.Detail.AuthorDisplay}}</dd>
        <dt>Created</dt><dd>{{reltime $c.Detail.CreatedAt}}</dd>
        <dt>Updated</dt><dd>{{reltime $c.Detail.UpdatedAt}}</dd>
        {{with $c.Detail.HeadSHA}}<dt>Head</dt><dd><code class="sha">{{printf "%.8s" .}}</code></dd>{{end}}
      </dl>
    </section>
  </aside>
</div>
{{end}}
