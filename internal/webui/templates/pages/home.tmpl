{{define "content"}}
<section class="card centered">
  <header class="card-head"><h1>Choose a GitLab instance</h1></header>
  <ul class="pick-list">
    {{range .Content}}
    <li><a href="{{.URL}}">{{template "icon" "server"}}<span class="pick-text"><span class="strong">{{.Name}}</span>{{if .Host}}<span class="muted">{{.Host}}</span>{{end}}</span>{{template "icon" "chevron-right"}}</a></li>
    {{end}}
  </ul>
</section>
{{end}}
