{{define "content"}}
{{$c := .Content}}
<section class="card runpage" data-events="{{$c.EventsURL}}" {{if $c.Done}}data-done="1"{{end}}>
  <header class="card-head">
    <h2>{{if $c.Done}}{{template "icon" "sparkle"}} AI review finished{{else}}<span class="spinner"></span> Reviewing {{$c.Run.Ref}}…{{end}}</h2>
    <span class="muted">started {{reltime $c.Run.Started}}</span>
    <span class="spacer"></span>
    {{if not $c.Done}}
    <form method="post" action="{{$c.CancelURL}}" class="inline-form">
      <button type="submit" class="btn btn-sm btn-reject">{{template "icon" "stop"}} Cancel review</button>
    </form>
    {{end}}
  </header>
  <div class="card-body">
    <div class="agent-strip" id="agent-strip" hidden></div>
    <pre class="runlog" id="runlog">{{range $c.Lines}}{{.}}
{{end}}</pre>
  </div>

  <div id="run-status" class="card-foot">
    {{if $c.Done}}
      {{if $c.Outcome.Cancelled}}
      <div class="notice warn">{{template "icon" "warn"}}<div>Review cancelled.</div></div>
      {{else if $c.Outcome.Err}}
      <div class="notice error">{{template "icon" "x-circle"}}<div>Review failed: {{$c.Outcome.Err}}</div></div>
      {{else}}
      <div class="notice ok">{{template "icon" "check-circle"}}<div>Review completed with {{$c.Outcome.Findings}} finding(s).</div></div>
      {{end}}
      {{if $c.Outcome.DraftReady}}
      <p class="muted">The accepted findings were published as a pending draft review. Publish it to make them visible, or leave them as drafts in GitLab.</p>
      {{end}}
      <div class="row">
        {{if $c.Outcome.DraftReady}}
        <form method="post" action="{{$c.PublishReviewURL}}" class="inline-form">
          <input type="hidden" name="project" value="{{$c.Nav.Project}}">
          <input type="hidden" name="iid" value="{{$c.Nav.IID}}">
          <button type="submit" class="btn btn-primary">{{template "icon" "send"}} Publish review now</button>
        </form>
        {{end}}
        {{if $c.FindingsURL}}<a class="btn{{if not $c.Outcome.DraftReady}} btn-primary{{end}}" href="{{$c.FindingsURL}}">{{template "icon" "checklist"}} Open findings</a>{{end}}
        {{if $c.LogURL}}<a class="btn" href="{{$c.LogURL}}">{{template "icon" "log"}} View full log</a>{{end}}
        <a class="btn btn-ghost" href="{{$c.Nav.DetailURL}}">Back to MR</a>
      </div>
    {{else}}
      <p class="muted">The page moves to the findings when the run completes. You can leave and come back from the AI review step.</p>
    {{end}}
  </div>
</section>
{{end}}
