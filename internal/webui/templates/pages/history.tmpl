{{define "content"}}
{{$c := .Content}}
{{if not $c.Entries}}
<div class="empty">
  {{template "icon" "history"}}
  <h2>No stored reviews yet</h2>
  <p>Run an AI review: its findings and run log are kept here, and reopen with their triage state.</p>
</div>
{{else}}
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Started</th><th>Result</th><th class="hide-narrow">Title</th><th class="actions-col"></th></tr></thead>
  <tbody>
    {{range $c.Entries}}
    <tr>
      <td class="nowrap"><span class="strong">{{reltime .Started}}</span> <span class="muted">{{datetime .Started}}</span></td>
      <td class="nowrap">{{if .FindingsURL}}{{plural .Findings "finding"}} <span class="muted">· {{.Accepted}} accepted{{if .Pending}} · <span class="warn-text">{{.Pending}} pending</span>{{end}}</span>{{else}}<span class="muted">log only</span>{{end}}</td>
      <td class="muted hide-narrow">{{.Title}}</td>
      <td class="actions-cell">
        {{if .FindingsURL}}<a class="btn btn-sm" href="{{.FindingsURL}}">{{template "icon" "checklist"}} Open findings</a>{{end}}
        {{if .LogURL}}<a class="btn btn-ghost btn-sm" href="{{.LogURL}}">{{template "icon" "log"}} Log</a>{{end}}
      </td>
    </tr>
    {{end}}
  </tbody>
</table>
</div>
{{end}}
{{end}}
