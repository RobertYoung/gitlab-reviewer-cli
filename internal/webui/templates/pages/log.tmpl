{{define "content"}}
{{$c := .Content}}
<section class="card logcard">
  <header class="card-head"><h2>{{template "icon" "log"}} Run log</h2><span class="muted mono">{{$c.Name}}</span></header>
  <div class="card-body">
    <div class="agent-strip" id="agent-strip" hidden></div>
    <pre class="runlog" id="runlog">{{$c.Text}}</pre>
  </div>
</section>
{{end}}
