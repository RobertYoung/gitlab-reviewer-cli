{{define "content"}}
{{$c := .Content}}
<section class="chatpage" data-events="{{$c.EventsURL}}"{{if not $c.State.Busy}} data-idle="1"{{end}}>
  <div class="chat-intro">
    <span class="summary-icon">{{template "icon" "discussion"}}</span>
    <div>
      <h2>Chat about {{if $c.FocusLabel}}<code>{{$c.FocusLabel}}</code>{{else}}{{$c.Ref}}{{end}}</h2>
      <p class="muted">Claude answers from a checkout of the MR branch and can read the surrounding code. Nothing here is posted to GitLab.</p>
    </div>
  </div>

  <div class="chatlog">
    {{range $c.State.Messages}}
    <div class="chat-msg {{if .You}}you{{else}}claude{{end}}">
      <div class="meta">{{if .You}}<span class="avatar mine" aria-hidden="true">{{template "icon" "person"}}</span>You{{else}}<span class="avatar ai" aria-hidden="true">{{template "icon" "sparkle"}}</span>Claude{{end}}</div>
      <pre class="prose">{{.Text}}</pre>
    </div>
    {{end}}
    {{if and (not $c.State.Messages) (not $c.State.Busy)}}
    <p class="muted chat-empty">No messages yet. Ask a question below.</p>
    {{end}}
    {{if $c.State.Busy}}
    <div class="chat-msg claude busy">
      <div class="meta"><span class="avatar ai" aria-hidden="true">{{template "icon" "sparkle"}}</span>Claude <span class="spinner"></span> <span class="muted">working…</span></div>
      <pre class="runlog chatstatus" id="chatstatus">{{range $c.State.Status}}{{.}}
{{end}}</pre>
    </div>
    {{end}}
  </div>

  {{if $c.State.Err}}<div class="notice error">{{template "icon" "warn"}}<div>{{$c.State.Err}}</div></div>{{end}}

  {{if $c.State.Busy}}
  <div class="row">
    <form method="post" action="{{$c.CancelURL}}" class="inline-form">
      <button type="submit" class="btn btn-reject">{{template "icon" "stop"}} Cancel reply</button>
    </form>
  </div>
  {{else if $c.State.Closed}}
  <div class="notice">{{template "icon" "info"}}<div>This chat has ended.</div></div>
  {{else}}
  <form method="post" action="{{$c.SendURL}}" class="chat-form">
    <textarea name="message" rows="3" placeholder="Ask about this change. Markdown supported." aria-label="message" autofocus></textarea>
    <div class="row">
      <span class="hint"><kbd>⌘</kbd><kbd>↵</kbd> sends</span>
      <span class="spacer"></span>
      <button type="submit" class="btn btn-primary">{{template "icon" "send"}} Send</button>
    </div>
  </form>
  {{end}}

  <div class="row chat-actions">
    {{if and (not $c.State.Closed) (not $c.State.Busy)}}
    <form method="post" action="{{$c.EndURL}}" class="inline-form">
      <input type="hidden" name="back" value="{{$c.Nav.DiffURL}}">
      <button type="submit" class="btn btn-ghost">End chat</button>
    </form>
    {{end}}
    <a class="btn btn-ghost" href="{{$c.Nav.DiffURL}}">{{template "icon" "diff"}} Back to diff</a>
  </div>
</section>
{{end}}
