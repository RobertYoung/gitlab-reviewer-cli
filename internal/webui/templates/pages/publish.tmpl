{{define "content"}}
{{$c := .Content}}
{{if not $c.Posted}}
<section class="card narrow-card">
  <header class="card-head"><h2>Publish {{len $c.Items}} comment(s) to {{$c.Detail.Ref}}</h2></header>
  {{if not $c.Items}}
  <div class="empty compact">
    {{template "icon" "checklist"}}
    <h2>Nothing accepted to publish</h2>
    <p>Accept findings on the findings page first.</p>
  </div>
  {{else}}
  <ul class="publish-items">
    {{range $c.Items}}
    <li>{{template "sevbadge" .}}<span class="ptitle">{{ftitle .}}</span><span class="loc">{{floc .}}</span></li>
    {{end}}
  </ul>
  <form method="post" action="{{$c.PostURL}}" class="publish-form card-body">
    <input type="hidden" name="project" value="{{$c.Nav.Project}}">
    <input type="hidden" name="iid" value="{{$c.Nav.IID}}">
    <input type="hidden" name="source" value="{{$c.Source}}">
    <input type="hidden" name="record" value="{{$c.RecordName}}">
    <fieldset class="mode-pick">
      <legend class="setting-label">How to post</legend>
      <label class="mode"><input type="radio" name="mode" value="draft" {{if eq $c.Mode "draft"}}checked{{end}}>
        <span><strong>Draft review</strong><span class="help">Comments stay invisible until you publish the review in one action.</span></span></label>
      <label class="mode"><input type="radio" name="mode" value="immediate" {{if eq $c.Mode "immediate"}}checked{{end}}>
        <span><strong>Immediate</strong><span class="help">Each comment appears on the MR as it is posted.</span></span></label>
    </fieldset>
    <div class="row">
      <button type="submit" class="btn btn-primary">{{template "icon" "send"}} Publish</button>
      <span class="muted">Posting is sequential and can take a few seconds per comment.</span>
    </div>
  </form>
  {{end}}
</section>

{{else}}
<section class="card narrow-card">
  <header class="card-head"><h2>{{if $c.DraftReady}}Draft review ready{{else}}Publish complete{{end}}</h2><span class="spacer"></span><span class="muted">{{$c.Inline}} inline · {{$c.Notes}} as notes · {{$c.Failed}} failed</span></header>
  {{if $c.TmplErr}}<div class="notice warn inset">{{template "icon" "warn"}}<div>{{$c.TmplErr}}</div></div>{{end}}
  <ul class="publish-items">
    {{range $c.Results}}
    <li>
      {{if .Err}}<span class="pill state-failed">{{template "icon" "cross"}} failed</span>
      {{else if eq (fstate .State) "published"}}<span class="pill state-published">{{template "icon" "check"}} {{if .F.File}}inline{{else}}note{{end}}</span>
      {{else if eq (fstate .State) "note"}}<span class="pill state-note">{{template "icon" "check"}} note (no inline position)</span>
      {{else}}<span class="pill">{{fstate .State}}</span>{{end}}
      <span class="ptitle">{{ftitle .F}}</span><span class="loc">{{floc .F}}</span>
      {{if .Err}}<div class="error">{{.Err}}</div>{{end}}
    </li>
    {{end}}
  </ul>
  <div class="card-body">
    {{if $c.DraftReady}}
    {{if eq $c.Mode "draft"}}<p class="muted">The comments were created as a pending review. Publish it to make them visible, or leave them as drafts in GitLab.</p>{{end}}
    <div class="row">
      <form method="post" action="{{$c.ReviewURL}}" class="inline-form">
        <input type="hidden" name="project" value="{{$c.Nav.Project}}">
        <input type="hidden" name="iid" value="{{$c.Nav.IID}}">
        <button type="submit" class="btn btn-primary">{{template "icon" "send"}} Publish review now</button>
      </form>
      <a class="btn" href="{{$c.Nav.DetailURL}}">Keep as drafts</a>
    </div>
    {{else}}
    <div class="row">
      <a class="btn btn-primary" href="{{$c.Nav.DetailURL}}">Back to MR</a>
      {{if $c.Detail.WebURL}}<a class="btn" href="{{$c.Detail.WebURL}}" target="_blank" rel="noopener">Open in GitLab {{template "icon" "external"}}</a>{{end}}
    </div>
    {{end}}
  </div>
</section>
{{end}}
{{end}}
