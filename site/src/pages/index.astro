---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { Image } from 'astro:assets';
import findings from '../assets/screenshots/gui-findings.png';
import exampleAgents from '../data/example-agents.json';
import options from '../data/config-options.json';

const base = import.meta.env.BASE_URL;
const sqlAgent = exampleAgents.find((a) => a.name === 'sql-migrations')!;
const previewKeys = ['review.agents', 'gate.min_severity', 'publish.mode', 'checkout.mode'];
const preview = previewKeys.map((key) => options.find((o) => o.key === key)!) as ((typeof options)[number] & { allowed?: string[] })[];

const steps = [
	['Checkout', 'The MR head is checked out into a detached git worktree, so Claude reads the whole repository, never your working tree.'],
	['Agents', 'Focused review agents (bug, security, performance, docs, style, design, plus your own) each make their own pass, in parallel.'],
	['Aggregate', 'An aggregation agent merges findings that describe the same defect into one, at the highest severity any source reported.'],
	['Triage', 'You accept, reject or edit every finding against its diff hunk. Nothing leaves your machine before this.'],
	['Publish', 'Accepted findings become positioned inline discussions, as a GitLab draft review or posted immediately.'],
];

const modes = [
	{ title: 'Terminal UI', cmd: 'gitlab-reviewer', href: 'tui/', text: 'Browse MRs, run reviews, triage findings, chat with Claude and approve, all from the keyboard.' },
	{ title: 'Browser GUI', cmd: 'gitlab-reviewer gui', href: 'gui/', text: 'The same pipeline as a local web app with a syntax-highlighted diff, inline findings and per-run agent picks.' },
	{ title: 'Headless and CI', cmd: "gitlab-reviewer review 'group/app!42'", href: 'headless/', text: 'One review per job, with a severity gate that fails the pipeline and JSON on stdout.' },
	{ title: 'Agents and plugin', cmd: '/plugin install gitlab-reviewer@gitlab-reviewer-cli', href: 'agent-driven/', text: 'Let Claude Code drive the loop through the CLI, with publishing kept behind your say-so.' },
];

const commands = ['mr list', 'mr show', 'review', 'review show', 'review accept', 'review reject', 'review edit', 'review publish', 'review submit', 'mr approve'];

const security = [
	['Read-only sandbox', 'Reviews get Read, Grep and Glob. Writes, shell and network tools are denied for the whole session.'],
	['Token stays local', 'The GitLab token is never passed to the claude subprocess, never logged and never written to git config.'],
	['Network is opt-in', 'review.allowed_domains grants WebFetch to the domains you list, and nothing else.'],
	['Shell is opt-in', 'review.allowed_commands grants Bash for the command patterns you list, such as npm test:*.'],
];

const json = `{
  "ref": "group/app!42",
  "summary": "…",
  "findings": [
    {
      "id": "f001",
      "file": "internal/store.go",
      "line": 25,
      "severity": "major",
      "agent": "bug",
      "state": "pending"
    }
  ],
  "gate": { "min_severity": "major", "blocking": 1, "passed": false }
}`;
---

<StarlightPage
	frontmatter={{
		title: 'Review GitLab merge requests with Claude',
		description: 'gitlab-reviewer runs focused Claude review agents on the real checkout of a GitLab merge request, lets you triage every finding, and publishes the keepers as inline comments.',
		template: 'splash',
		hero: {},
		tableOfContents: false,
		pagefind: false,
	}}
>
	<div class="landing not-content">
		<figure class="shot">
			<div class="shot-chrome" aria-hidden="true">
				<span class="dots"><i></i><i></i><i></i></span>
				<span class="addr">127.0.0.1 · gitlab-reviewer gui</span>
			</div>
			<Image src={findings} alt="The gitlab-reviewer browser GUI on a merge request's Findings tab: a pipeline header with AI review, Triage, Publish and Approve stages, a list of findings grouped by pending, accepted and rejected, and the selected major finding with its suggested change and diff." widths={[800, 1360, 2720]} sizes="(max-width: 72rem) 100vw, 72rem" loading="eager" />
			<figcaption>The browser GUI's findings triage, captured from the app with sample data.</figcaption>
		</figure>

		<section aria-labelledby="how">
			<p class="kicker">How it works</p>
			<h2 id="how">From merge request to inline comments</h2>
			<ol class="steps">
				{
					steps.map(([title, text], i) => (
						<li>
							<span class="step-n">{i + 1}</span>
							<h3>{title}</h3>
							<p>{text}</p>
						</li>
					))
				}
			</ol>
		</section>

		<section aria-labelledby="ways">
			<p class="kicker">Frontends</p>
			<h2 id="ways">Four ways to run it</h2>
			<p class="sub">Every frontend drives the same pipeline and shares the same stored reviews, so a review started in one can be reopened in another.</p>
			<ul class="cards">
				{
					modes.map((m) => (
						<li class="card">
							<h3>
								<a href={base + m.href}>{m.title}</a>
							</h3>
							<p>{m.text}</p>
							<code>{m.cmd}</code>
						</li>
					))
				}
			</ul>
		</section>

		<section class="split" aria-labelledby="cli">
			<div>
				<p class="kicker">CLI for agents</p>
				<h2 id="cli">The whole review loop, scriptable</h2>
				<p class="sub">Every command takes <code>--output json</code>, never prompts, and writes progress to stderr. An agent can find an MR, run the review, triage, publish and approve.</p>
				<ul class="chips" aria-label="Commands">
					{
						commands.map((c) => (
							<li>
								<a class="gr-chip" href={`${base}reference/cli/#gitlab-reviewer-${c.replace(' ', '-')}`}>{c}</a>
							</li>
						))
					}
				</ul>
				<table class="exit">
					<caption>Exit codes</caption>
					<thead><tr><th scope="col">Code</th><th scope="col">Meaning</th></tr></thead>
					<tbody>
						<tr><td><code>0</code></td><td>Completed. No gate is configured, or the gate passed.</td></tr>
						<tr><td><code>1</code></td><td>Any failure: configuration, GitLab API, the review run, or publishing a finding.</td></tr>
						<tr><td><code>2</code></td><td>The severity gate failed, or <code>mr approve</code> was refused by <code>gate.approvals: block</code>.</td></tr>
					</tbody>
				</table>
			</div>
			<div class="terminal">
				<Code wrap code={json} lang="json" title="review --output json (abridged example)" />
			</div>
		</section>

		<section class="split" aria-labelledby="byo">
			<div>
				<p class="kicker">Review agents</p>
				<h2 id="byo">Bring your own agents</h2>
				<p class="sub">An agent is a Markdown file: frontmatter plus a prompt. The format is compatible with Claude Code subagents, so one file can serve both tools.</p>
				<p class="label">Built in</p>
				<ul class="chips">
					{['bug', 'security', 'performance', 'docs', 'style', 'design'].map((a) => <li class="gr-chip">{a}</li>)}
				</ul>
				<dl class="dirs">
					<dt>Personal</dt>
					<dd><code>~/.config/gitlab-reviewer/agents/</code> or <code>~/.claude/agents/</code></dd>
					<dt>Team</dt>
					<dd><code>.gitlab-reviewer/agents/</code> or <code>.claude/agents/</code> in the reviewed repo</dd>
				</dl>
				<p><a class="more" href={`${base}example-agents/`}>Browse the example agents <span aria-hidden="true">→</span></a></p>
			</div>
			<div class="terminal">
				<Code wrap code={sqlAgent.source} lang="markdown" title={`examples/agents/${sqlAgent.file}`} />
			</div>
		</section>

		<section class="band" aria-labelledby="sec">
			<p class="kicker">Security model</p>
			<h2 id="sec">The MR author's code is untrusted, so the review is sandboxed</h2>
			<ul class="sec">
				{
					security.map(([title, text]) => (
						<li>
							<h3>{title}</h3>
							<p>{text}</p>
						</li>
					))
				}
			</ul>
			<p><a class="more" href={`${base}security-model/`}>Read the security model <span aria-hidden="true">→</span></a></p>
		</section>

		<section class="split" aria-labelledby="config">
			<div>
				<p class="kicker">Configuration</p>
				<h2 id="config">Every setting, three ways</h2>
				<p class="sub">Settings come from flags, then <code>GITLAB_REVIEWER_*</code> environment variables, then <code>~/.config/gitlab-reviewer/config.yaml</code>, then defaults. The reference is generated from the code, so it cannot drift.</p>
				<p><a class="btn" href={`${base}reference/configuration/`}>Open the configuration reference</a></p>
			</div>
			<ul class="opts" aria-label="Sample options">
				{
					preview.map((o) => (
						<li>
							<a href={`${base}reference/configuration/#${o.key}`}><code>{o.key}</code></a>
							<span class="opt-chips">
								<span class="gr-chip">{o.type}</span>
								{o.default && <span class="gr-chip">default: {o.default}</span>}
							</span>
							{o.allowed && <span class="opt-allowed">{o.allowed.join(' · ')}</span>}
						</li>
					))
				}
			</ul>
		</section>

		<footer class="foot">
			<p>gitlab-reviewer is open source under the MIT license. <a href="https://github.com/RobertYoung/gitlab-reviewer-cli">Source on GitHub</a> · <a href="https://github.com/RobertYoung/gitlab-reviewer-cli/releases">Releases</a> · <a href="https://github.com/RobertYoung/gitlab-reviewer-cli/issues">Issues</a></p>
		</footer>
	</div>
</StarlightPage>

<style>
	.landing {
		display: flex;
		flex-direction: column;
		gap: 5rem;
		padding-bottom: 2rem;
		color: var(--gr-text);
	}
	.landing h2 {
		margin: 0.25rem 0 0;
		color: var(--gr-strong);
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}
	.landing h3 {
		margin: 0;
		color: var(--gr-strong);
		font-size: var(--sl-text-base);
		font-weight: 600;
	}
	.landing p {
		margin: 0;
	}
	.landing code {
		font-family: var(--gr-mono);
		font-size: 0.875em;
	}
	.landing a {
		color: var(--gr-primary);
	}
	.kicker {
		color: var(--gr-primary);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.sub {
		max-width: 40rem;
		margin-top: 0.75rem !important;
		color: var(--gr-muted);
		line-height: 1.6;
	}
	.label {
		margin-top: 1.5rem !important;
		color: var(--gr-muted);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.shot {
		margin: 2rem 0 0;
		border: 1px solid var(--gr-border);
		border-radius: 12px;
		overflow: hidden;
		background: var(--gr-shell);
		box-shadow: var(--gr-overlay);
	}
	.shot-chrome {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.625rem 0.875rem;
		border-bottom: 1px solid var(--gr-border);
		background: var(--gr-surface);
	}
	.dots {
		display: flex;
		gap: 6px;
	}
	.dots i {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--gr-border);
	}
	.addr {
		flex: 1;
		max-width: 22rem;
		margin: 0 auto;
		padding: 0.15rem 0.75rem;
		border: 1px solid var(--gr-border);
		border-radius: 6px;
		background: var(--gr-bg);
		color: var(--gr-muted);
		font: var(--sl-text-xs) / 1.6 var(--gr-mono);
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.shot img {
		display: block;
		width: 100%;
		height: auto;
	}
	.shot figcaption {
		padding: 0.625rem 1rem;
		border-top: 1px solid var(--gr-border);
		background: var(--gr-surface);
		color: var(--gr-muted);
		font-size: var(--sl-text-xs);
		text-align: center;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 1rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.steps li {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid var(--gr-border);
		border-radius: 10px;
		background: var(--gr-surface);
	}
	.step-n {
		display: inline-grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border: 1.5px solid var(--gr-primary-emph);
		border-radius: 50%;
		color: var(--gr-primary);
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	.steps p,
	.card p,
	.sec p {
		color: var(--gr-muted);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem;
		border: 1px solid var(--gr-border);
		border-radius: 10px;
		background: var(--gr-surface);
	}
	.card:hover {
		border-color: var(--gr-primary-emph);
	}
	.card h3 a {
		color: var(--gr-strong);
		text-decoration: none;
	}
	.card h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 10px;
	}
	.card h3 a:focus-visible {
		outline: none;
	}
	.card:has(a:focus-visible) {
		outline: 2px solid var(--gr-primary-emph);
		outline-offset: 2px;
	}
	.card code {
		margin-top: auto;
		padding: 0.375rem 0.625rem;
		border-radius: 6px;
		background: var(--gr-neutral);
		color: var(--gr-strong);
		overflow-wrap: anywhere;
	}

	.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	.chips a.gr-chip {
		color: var(--gr-strong);
		text-decoration: none;
	}
	.chips a.gr-chip:hover {
		border-color: var(--gr-primary-emph);
	}
	.exit {
		width: 100%;
		margin-top: 1.5rem;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	.exit caption {
		margin-bottom: 0.5rem;
		color: var(--gr-muted);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-align: left;
		text-transform: uppercase;
	}
	.exit th,
	.exit td {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--gr-border);
		text-align: left;
		vertical-align: top;
	}
	.exit th {
		background: var(--gr-surface);
		color: var(--gr-strong);
		font-weight: 600;
	}
	.terminal {
		min-width: 0;
	}
	.dirs {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.5rem 1rem;
		margin: 1.5rem 0 1rem;
		font-size: var(--sl-text-sm);
	}
	.dirs dt {
		color: var(--gr-strong);
		font-weight: 600;
	}
	.dirs dd {
		margin: 0;
		color: var(--gr-muted);
	}
	.dirs code {
		color: var(--gr-text);
		overflow-wrap: anywhere;
	}
	.more {
		font-weight: 600;
		text-decoration: none;
	}
	.more:hover {
		text-decoration: underline;
	}

	.band {
		padding: 2.5rem;
		border: 1px solid var(--gr-border);
		border-radius: 14px;
		background: var(--gr-surface);
	}
	.sec {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 1.5rem;
		margin: 2rem 0 1.5rem;
		padding: 0;
		list-style: none;
	}
	.sec li {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-left: 1rem;
		border-left: 2px solid var(--gr-success);
	}

	.btn {
		display: inline-flex;
		margin-top: 1.5rem;
		padding: 0.625rem 1.25rem;
		border: 1px solid var(--gr-border);
		border-radius: 8px;
		background: var(--gr-bg);
		color: var(--gr-strong) !important;
		font-weight: 600;
		text-decoration: none;
	}
	.btn:hover {
		border-color: var(--gr-muted);
	}
	.opts {
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--gr-border);
		border-radius: 10px;
		overflow: hidden;
	}
	.opts li {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 0.875rem 1rem;
	}
	.opts li + li {
		border-top: 1px solid var(--gr-border);
	}
	.opts a {
		font-weight: 600;
		text-decoration: none;
	}
	.opts a:hover {
		text-decoration: underline;
	}
	.opt-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}
	.opt-allowed {
		color: var(--gr-muted);
		font: var(--sl-text-xs) / 1.5 var(--gr-mono);
	}

	.foot {
		padding-top: 2rem;
		border-top: 1px solid var(--gr-border);
		color: var(--gr-muted);
		font-size: var(--sl-text-sm);
		text-align: center;
	}

	@media (max-width: 50rem) {
		.landing {
			gap: 3.5rem;
		}
		.split {
			grid-template-columns: minmax(0, 1fr);
			gap: 2rem;
		}
		.band {
			padding: 1.5rem;
		}
	}
</style>
