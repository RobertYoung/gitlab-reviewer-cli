---
const base = import.meta.env.BASE_URL;
const install = 'go install github.com/RobertYoung/gitlab-reviewer-cli/cmd/gitlab-reviewer@latest';
---

<section class="hero not-content">
	<a class="eyebrow" href={`${base}agent-driven/`}>
		<span class="eyebrow-tag">Agents</span>
		<span>Agent-ready CLI with <code>--output json</code></span>
		<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12"><path fill="currentColor" d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z"></path></svg>
	</a>
	<h1 id="_top">Review GitLab merge requests with Claude, on the real checkout.</h1>
	<p class="lede">gitlab-reviewer runs focused review agents against the MR branch with full repository context, merges duplicate findings, lets you accept, reject or edit each one, then publishes the keepers as inline GitLab comments.</p>
	<div class="install">
		<code><span aria-hidden="true">$ </span>{install}</code>
		<button type="button" class="copy" data-copy={install} aria-label="Copy install command">
			<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path><path fill="currentColor" d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path></svg>
			<span class="copy-label">Copy</span>
		</button>
	</div>
	<p class="note">Or grab a prebuilt binary from <a href="https://github.com/RobertYoung/gitlab-reviewer-cli/releases">GitHub Releases</a>. Requires the <code>claude</code> CLI 2.0 or newer, <code>git</code> and a GitLab token. Runs on Anthropic or AWS Bedrock.</p>
	<div class="actions">
		<a class="btn primary" href={`${base}getting-started/`}>Get started <span aria-hidden="true">→</span></a>
		<a class="btn" href={`${base}reference/configuration/`}>Configuration reference</a>
	</div>
</section>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.hero .copy')) {
		button.addEventListener('click', async () => {
			const label = button.querySelector('.copy-label')!;
			try {
				await navigator.clipboard.writeText(button.dataset.copy!);
				label.textContent = 'Copied';
			} catch {
				label.textContent = 'Copy failed';
			}
			setTimeout(() => (label.textContent = 'Copy'), 2000);
		});
	}
</script>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		padding: 3rem 0 1rem;
		text-align: center;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.75rem 0.25rem 0.25rem;
		border: 1px solid var(--gr-border);
		border-radius: 999px;
		background: var(--gr-surface);
		color: var(--gr-text);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	.eyebrow:hover {
		border-color: var(--gr-muted);
	}
	.eyebrow-tag {
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: var(--gr-primary-soft);
		color: var(--gr-primary);
		font-weight: 600;
	}
	.eyebrow code {
		white-space: nowrap;
		font-family: var(--gr-mono);
		color: var(--gr-strong);
	}
	h1 {
		max-width: 18ch;
		margin: 0;
		color: var(--gr-strong);
		font-size: clamp(2.25rem, 6vw, 4rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}
	.lede {
		max-width: 40rem;
		margin: 0;
		color: var(--gr-muted);
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		text-wrap: pretty;
	}
	.install {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		max-width: 100%;
		margin-top: 0.5rem;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		border: 1px solid var(--gr-border);
		border-radius: 10px;
		background: var(--gr-surface);
	}
	.install code {
		overflow-x: auto;
		color: var(--gr-strong);
		font: var(--sl-text-sm) / 1.6 var(--gr-mono);
		white-space: nowrap;
		text-align: left;
	}
	.install code span {
		color: var(--gr-muted);
	}
	.copy {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 0.375rem;
		padding: 0.375rem 0.625rem;
		border: 1px solid var(--gr-border);
		border-radius: 6px;
		background: var(--gr-bg);
		color: var(--gr-text);
		font: 500 var(--sl-text-xs) / 1.4 var(--gr-font);
		cursor: pointer;
	}
	.copy:hover {
		border-color: var(--gr-muted);
		color: var(--gr-strong);
	}
	.note {
		max-width: 44rem;
		margin: 0;
		color: var(--gr-muted);
		font-size: var(--sl-text-sm);
	}
	.note a {
		color: var(--gr-primary);
	}
	.note code {
		font-family: var(--gr-mono);
		color: var(--gr-text);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 1.25rem;
		border: 1px solid var(--gr-border);
		border-radius: 8px;
		background: var(--gr-surface);
		color: var(--gr-strong);
		font-weight: 600;
		text-decoration: none;
	}
	.btn:hover {
		border-color: var(--gr-muted);
	}
	.btn.primary {
		border-color: var(--gr-primary-emph);
		background: var(--gr-primary-emph);
		color: #fff;
	}
	.btn.primary:hover {
		filter: brightness(0.9);
	}
	@media (max-width: 40rem) {
		.hero {
			padding-top: 1.5rem;
		}
		.install .copy-label {
			display: none;
		}
		.eyebrow-tag {
			display: none;
		}
	}
</style>
